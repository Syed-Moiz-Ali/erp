# MassERP backend — PRODUCTION environment.
# Loaded AUTOMATICALLY in profile and release builds (kProfileMode / kReleaseMode).
#
# Replace the placeholder below with the real HTTPS production endpoint before
# shipping. Validate the value against the production security rules: HTTPS only,
# and no placeholder, loopback, private-network or HTTP URL (these are rejected).
#
# Never put credentials, tokens, client secrets or keys in this file.
API_BASE_URL=https://api.yourdomain.com
AUTH_MODE=backend
