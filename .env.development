# MassERP backend — DEVELOPMENT environment.
# Loaded AUTOMATICALLY in debug builds (kDebugMode); no --dart-define needed.
#
# Point API_BASE_URL at your current ngrok HTTPS tunnel. A temporary ngrok
# tunnel gets a new hostname each restart, so update this value and restart the
# Flutter app when the tunnel changes.
#
# Never put credentials, tokens, client secrets or keys in this file.
API_BASE_URL=https://unkempt-cucumber-chastise.ngrok-free.dev
AUTH_MODE=backend
